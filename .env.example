# EPSON TM-T82II Test Printer Configuration

# ========================================
# Network Printer (TCP/IP) Configuration
# ========================================

# Printer IP Address (for TCP/IP connection)
# Example: 192.168.1.100
PRINTER_IP=192.168.1.100

# Printer Port (standard for EPSON thermal: 9100)
PRINTER_PORT=9100

# Connection type: 'tcp' or 'usb'
CONNECTION_TYPE=tcp


# ========================================
# USB Printer Configuration
# ========================================

# USB Device Path (for USB connection)
# Linux: /dev/usb/lp0 (may also be /dev/usb/lp1, /dev/lp0, etc)
# Find with: lsusb or ls /dev/usb/lp*
USB_DEVICE_PATH=/dev/usb/lp0


# ========================================
# Printer Details (Optional - for logging)
# ========================================

PRINTER_NAME=EPSON TM-T82II
PRINTER_MODEL=TM-T82II
PAPER_WIDTH=80  # mm (80 or 58)


# ========================================
# Debug Settings
# ========================================

# Enable debug logging
DEBUG=false

# Verbose output
VERBOSE=false
